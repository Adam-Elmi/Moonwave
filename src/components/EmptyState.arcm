# ###################
# EmptyState: what an empty library shows (Add Music Folder), or a problem
# ###################
runtime ${
  import { status, folders, problem, startAddFolder, scanStage } from "../lib/state.js";
}$

[section = class: "empty", data-hidden: runtime ${ (status()?.tracks ?? 0) > 0 || folders().length > 0 }$]
  [svg = class: "art", viewBox: "0 0 64 64", aria-hidden: "true"]
    [path = d: "M38 10a20 20 0 1 0 16 30 16 16 0 1 1-16-30z" !]
    [path = d: "M8 52c6-5 12-5 18 0s12 5 18 0 10-4 12-2" !]
  [end]
  [h2]Your music lives here[end]
  [p]Add a music folder to start. Moonwave reads the songs in it and keeps them in your library.[end]
  [button = class: "pill", type: "button", disabled: runtime ${ scanStage() === "running" }$, onclick: runtime ${ startAddFolder }$]Add Music Folder[end]
  [p = class: "problem", data-show: runtime ${ problem() !== "" }$]runtime ${ problem() }$[end]
[end:section]

[style]
  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 24px;
    text-align: center;
  }
  .empty[data-hidden] {
    display: none;
  }
  .art {
    width: 96px;
    height: 96px;
    margin-bottom: 12px;
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  h2 {
    margin: 0 0 6px;
    font-size: 19px;
    color: var(--ink);
  }
  p {
    max-width: 420px;
    margin: 0;
    font-size: var(--text);
    line-height: 1.5;
    color: var(--muted);
  }
  /* GNOME's suggested-action pill button, in Moonwave rose */
  .pill {
    margin-top: 20px;
    padding: 10px 22px;
    font: 500 var(--text)/1 var(--font);
    color: #fff;
    background: var(--accent);
    border: 0;
    border-radius: var(--radius);
    cursor: pointer;
  }
  .pill:hover {
    background: var(--accent-hover);
  }
  .pill:disabled {
    opacity: 0.6;
  }
  .problem {
    display: none;
    margin-top: 14px;
    color: var(--error);
  }
  .problem[data-show] {
    display: block;
  }
[end]
