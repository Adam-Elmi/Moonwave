# ###################
# LibraryView: the sidebar, a Zed-like panel (Lists: Recently Added, Most Played and your own,
# with + for a new one; then the music folders with rescan, remove and a warning when one is
# gone) and the browse view (its tabs switch Songs / Albums / Artists), once the library has a folder.
# List and folder rows are drawn by runtime code (no live [for-each] yet).
# On a narrow window the sidebar hides; ☰ in the title bar slides it in over the page (choosing
# something, a click beside it or Esc closes it)
# ###################
[import = BrowseView: "@/components/BrowseView.arcm" !]

runtime ${
  import { effect } from "arcmoon/reactive";
  import { status, folders, rescan, askRemoveFolder, scanStage, detail, lists, openList, openSmart, newList, openFolder, sideOpen, closeSide } from "../lib/state.js";
  import { count } from "../lib/format.js";

  const folderList = ArcMoon.ref(ArcMoon.defineRef("folderList"));
  const listNav = ArcMoon.ref(ArcMoon.defineRef("listNav"));

  // your lists, A–Z; the open one is marked
  effect(() => {
    const open = detail()?.kind === "list" ? detail().id : null;
    listNav.replaceChildren(
      ...lists().map((l) => {
        const b = document.createElement("button");
        b.type = "button";
        b.dataset.list = l.id;
        b.toggleAttribute("data-on", l.id === open);
        b.innerHTML = `<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 4h8M2.5 8h8M2.5 12h5M12.5 6.5v6.5M12.5 13a1.5 1.5 0 1 1-1.5-1.5"/></svg>`;
        const name = document.createElement("span");
        name.className = "name";
        name.textContent = l.name;
        const n = document.createElement("span");
        n.className = "n";
        n.textContent = l.tracks.toLocaleString();
        b.append(name, n);
        return b;
      })
    );
  });
  // a folder opens its page (its songs; downloads then go there)
  const pickFolder = (e) => {
    if (e.target.closest("button")) return;
    const id = e.target.closest("[data-folder]")?.dataset.folder;
    if (id) openFolder(id), closeSide();
  };
  const folderKey = (e) => e.key === "Enter" && pickFolder(e);
  const pickList = (e) => {
    const id = e.target.closest("[data-list]")?.dataset.list;
    if (id) openList(id), closeSide();
  };
  const smart = (which) => () => (openSmart(which), closeSide());
  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && sideOpen()) {
      e.preventDefault();
      e.stopImmediatePropagation();
      closeSide();
    }
  }, true);
  const smartOn = (which) => detail()?.kind === "smart" && detail().which === which;

  const icon = (d) => `<svg viewBox="0 0 16 16" aria-hidden="true"><path d="${d}"/></svg>`;
  const RESCAN = "M13 8a5 5 0 1 1-1.5-3.5M13 3v2.5h-2.5";
  const REMOVE = "M4.5 4.5l7 7M11.5 4.5l-7 7";

  effect(() => {
    const busy = scanStage() === "running";
    const open = detail()?.kind === "folder" ? detail().id : null;
    folderList.replaceChildren(
      ...folders().map((f) => {
        const li = document.createElement("li");
        li.className = "folder";
        li.dataset.folder = f.id;
        li.tabIndex = 0;
        li.toggleAttribute("data-missing", !f.exists);
        li.toggleAttribute("data-on", f.id === open);
        li.title = f.exists ? f.path : `${f.path} can’t be found`;
        const text = document.createElement("div");
        text.className = "text";
        const name = document.createElement("b");
        name.textContent = f.name;
        const meta = document.createElement("small");
        meta.textContent = f.exists ? count(f.tracks, "song", "songs") : "Folder not found";
        text.append(name, meta);
        const again = document.createElement("button");
        again.type = "button";
        again.className = "icon";
        again.title = "Rescan for new and changed songs";
        again.disabled = busy || !f.exists;
        again.innerHTML = icon(RESCAN);
        again.onclick = (e) => {
          e.stopPropagation();
          rescan(f.id);
        };
        const drop = document.createElement("button");
        drop.type = "button";
        drop.className = "icon";
        drop.title = "Remove from the library";
        drop.disabled = busy;
        drop.innerHTML = icon(REMOVE);
        drop.onclick = (e) => {
          e.stopPropagation();
          askRemoveFolder(f.id);
        };
        li.append(text, again, drop);
        return li;
      })
    );
  });

}$

[div = class: "library", data-hidden: runtime ${ folders().length === 0 && (status()?.tracks ?? 0) === 0 }$]
  [div = class: "scrim", data-open: runtime ${ sideOpen() }$, onclick: runtime ${ closeSide }$][end]
  [aside = class: "sidebar", data-open: runtime ${ sideOpen() }$]

    [div = class: "section"]
      [h3]Lists[end]
      [button = class: "add", type: "button", title: "New list", aria-label: "New list", onclick: runtime ${ () => newList() }$]
        [svg = viewBox: "0 0 16 16", aria-hidden: "true"][path = d: "M8 3.5v9M3.5 8h9" !][end]
      [end]
    [end:div]
    [nav = class: "views"]
      [button = type: "button", data-on: runtime ${ smartOn("recent") }$, onclick: runtime ${ smart("recent") }$]
        [svg = viewBox: "0 0 16 16", aria-hidden: "true"][circle = cx: "8", cy: "8", r: "5.5" !][path = d: "M8 5v3l2 1.5" !][end]
        Recently Added
      [end]
      [button = type: "button", data-on: runtime ${ smartOn("played") }$, onclick: runtime ${ smart("played") }$]
        [svg = viewBox: "0 0 16 16", aria-hidden: "true"][path = d: "M8 13.5s-5-3-5-6.8A2.7 2.7 0 0 1 8 5a2.7 2.7 0 0 1 5 1.7c0 3.8-5 6.8-5 6.8z" !][end]
        Most Played
      [end]
    [end:nav]
    [nav = class: "views mine", arcm-ref: "listNav", onclick: runtime ${ pickList }$][end]

    [h3]Folders[end]
    [ul = class: "folders", arcm-ref: "folderList", onclick: runtime ${ pickFolder }$, onkeydown: runtime ${ folderKey }$][end]
  [end:aside]
  [BrowseView !]
[end:div]

[style]
  .library {
    position: relative;
    display: flex;
    height: 100%;
  }
  .scrim {
    display: none;
  }
  @media (max-width: 720px) {
    .sidebar {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      z-index: 9;
      width: min(280px, 85%);
      box-shadow: var(--shadow);
      transform: translateX(-105%);
      transition: transform 0.18s ease-out;
    }
    .sidebar[data-open] {
      transform: none;
    }
    .scrim[data-open] {
      position: absolute;
      inset: 0;
      z-index: 8;
      display: block;
      background: rgb(0 0 0 / 0.3);
    }
  }
  .library[data-hidden] {
    display: none;
  }

  /* ###################
     The sidebar: a flat panel with small section headers and dense rows
     ################### */
  .sidebar {
    width: 240px;
    flex-shrink: 0;
    padding: 8px 6px;
    overflow-y: auto;
    background: var(--panel);
    border-right: 1px solid var(--line-soft);
  }
  .section {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  h3 {
    margin: 10px 8px 4px;
    font: 500 11px var(--mono);
    color: var(--faint);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .add {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    margin: 6px 4px 0 0;
    padding: 0;
    color: var(--muted);
    background: none;
    border: 0;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .add:hover {
    color: var(--ink);
    background: var(--control-hover);
  }
  svg,
  .views :global(svg),
  .folders :global(svg) {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* lists: Recently Added, Most Played, yours */
  .views {
    display: flex;
    flex-direction: column;
  }
  .views :global(button) {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 26px;
    padding: 0 8px;
    font: 400 var(--text) var(--font);
    color: var(--ink);
    text-align: left;
    background: none;
    border: 0;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .views :global(button svg) {
    color: var(--muted);
  }
  .views :global(button:hover) {
    background: var(--hover);
  }
  .views :global(button[data-on]) {
    background: var(--selected);
  }
  .views :global(button[data-on] svg) {
    color: var(--accent);
  }
  .views :global(.name) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .n,
  .views :global(.n) {
    margin-left: auto;
    font: 400 11px var(--mono);
    color: var(--faint);
  }
  .mine:empty {
    display: none;
  }

  /* the music folders */
  .folders {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .folders :global(.folder) {
    display: flex;
    align-items: center;
    gap: 4px;
    min-height: 26px;
    padding: 3px 4px 3px 8px;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .folders :global(.folder:hover) {
    background: var(--hover);
  }
  .folders :global(.folder[data-on]) {
    background: var(--selected);
  }
  .folders :global(.folder:focus-visible) {
    outline: 1px solid var(--accent);
    outline-offset: -1px;
  }
  .folders :global(.text) {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
  }
  .folders :global(b) {
    overflow: hidden;
    font-size: var(--text);
    font-weight: 400;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--ink);
  }
  .folders :global(.folder[data-on] b) {
    color: var(--accent);
  }
  .folders :global(small) {
    font: 400 11px var(--mono);
    color: var(--faint);
  }
  .folders :global(.folder[data-missing] small) {
    color: var(--warn);
  }
  .folders :global(.icon) {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    padding: 0;
    color: var(--muted);
    background: none;
    border: 0;
    border-radius: var(--radius-sm);
    cursor: pointer;
    opacity: 0;
  }
  .folders :global(.folder:hover .icon),
  .folders :global(.icon:focus-visible) {
    opacity: 1;
  }
  .folders :global(.icon:hover:not(:disabled)) {
    color: var(--ink);
    background: var(--control-hover);
  }
  .folders :global(.icon:disabled) {
    cursor: default;
  }
  .folders :global(.folder:hover .icon:disabled) {
    opacity: 0.3;
  }
[end]
