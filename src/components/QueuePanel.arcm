# ###################
# QueuePanel: slides in on the right, above the player bar. Now playing, then what's next
# (click to jump, × to remove), and Clear for everything still to come. Esc closes it
# ###################
runtime ${
  import { effect } from "arcmoon/reactive";
  import { queue, index, current, queueOpen, toggleQueue, jump, removeAt, clearUpcoming } from "../lib/player.js";
  import { songRow } from "../lib/draw.js";

  const nowList = ArcMoon.ref(ArcMoon.defineRef("nowList"));
  const nextList = ArcMoon.ref(ArcMoon.defineRef("nextList"));

  // up to 300 rows: a whole library can be queued
  const LIMIT = 300;
  effect(() => {
    const list = queue();
    const at = index();
    nowList.replaceChildren(...(list[at] ? [songRow(list[at])] : []));
    const rows = list.slice(at + 1, at + 1 + LIMIT).map((song, n) => {
      const row = songRow(song);
      row.dataset.at = String(at + 1 + n);
      const x = document.createElement("button");
      x.type = "button";
      x.className = "remove";
      x.title = "Remove from the queue";
      x.textContent = "×";
      row.append(x);
      return row;
    });
    nextList.replaceChildren(...rows);
  });

  const click = (e) => {
    const row = e.target.closest("[data-at]");
    if (!row) return;
    const at = Number(row.dataset.at);
    if (e.target.closest(".remove")) removeAt(at);
    else jump(at);
  };

  window.addEventListener("keydown", (e) => {
    if (queueOpen() && e.key === "Escape" && !document.querySelector(".backdrop[data-open]")) {
      e.preventDefault();
      e.stopImmediatePropagation();
      toggleQueue();
    }
  }, true);

  const upcoming = () => Math.max(0, queue().length - index() - 1);
}$

[aside = class: "queue", data-open: runtime ${ queueOpen() && queue().length > 0 }$]
  [div = class: "head"]
    [h2]Queue[end]
    [button = class: "clear", type: "button", disabled: runtime ${ upcoming() === 0 }$, onclick: runtime ${ clearUpcoming }$]Clear[end]
  [end:div]
  [div = class: "scroll"]
    [h3]Now playing[end]
    [ul = class: "list", arcm-ref: "nowList"][end]
    [h3]runtime ${ upcoming() ? `Next · ${upcoming().toLocaleString()}` : "Nothing next" }$[end]
    [ul = class: "list", arcm-ref: "nextList", onclick: runtime ${ click }$][end]
    [p = class: "more", data-show: runtime ${ upcoming() > 300 }$]runtime ${ `and ${(upcoming() - 300).toLocaleString()} more` }$[end]
  [end:div]
[end:aside]

[style]
  .queue {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 6;
    display: flex;
    flex-direction: column;
    width: 360px;
    max-width: 90%;
    background: var(--panel);
    border-left: 1px solid var(--line-soft);
    box-shadow: var(--shadow);
    transform: translateX(105%);
    transition: transform 0.2s ease-out;
  }
  .queue[data-open] {
    transform: none;
  }
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px 6px;
  }
  h2 {
    margin: 0;
    font-size: 15px;
    color: var(--ink);
  }
  .clear {
    height: 30px;
    padding: 0 12px;
    font: 500 13px var(--font);
    color: var(--ink);
    background: var(--control);
    border: 0;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .clear:hover:not(:disabled) {
    background: var(--control-hover);
  }
  .clear:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .scroll {
    flex: 1;
    min-height: 0;
    padding: 0 16px 16px;
    overflow-y: auto;
  }
  h3 {
    margin: 14px 4px 8px;
    font-size: 12px;
    font-weight: 700;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .list:empty {
    display: none;
  }
  .list :global(.song) {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 10px;
    border-bottom: 1px solid var(--line);
    cursor: pointer;
  }
  .list :global(.song:last-child) {
    border-bottom: 0;
  }
  .list :global(.song:hover) {
    background: var(--hover);
  }
  .list :global(.art) {
    position: relative;
    display: grid;
    place-items: center;
    width: 36px;
    height: 28px;
    flex-shrink: 0;
    overflow: hidden;
    font: 700 12px var(--font);
    color: rgb(255 255 255 / 0.92);
    background: linear-gradient(150deg, hsl(var(--hue) 45% 52%), hsl(var(--hue) 50% 34%));
    border-radius: var(--radius-sm);
  }
  .list :global(.art img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .list :global(.text) {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
  }
  .list :global(b),
  .list :global(small) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .list :global(b) {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
  }
  .list :global(small) {
    font-size: 12px;
    color: var(--muted);
  }
  .list :global(.artist),
  .list :global(.album) {
    display: none;
  }
  .list :global(.length) {
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }
  .list :global(.remove) {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    font-size: 16px;
    line-height: 1;
    color: var(--muted);
    background: none;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    opacity: 0;
  }
  .list :global(.song:hover .remove) {
    opacity: 1;
  }
  .list :global(.remove:hover) {
    color: var(--ink);
    background: var(--control);
  }
  .more {
    display: none;
    margin: 10px 4px 0;
    font-size: 12px;
    color: var(--muted);
  }
  .more[data-show] {
    display: block;
  }
[end]
