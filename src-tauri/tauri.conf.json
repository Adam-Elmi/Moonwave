{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Moonwave",
  "version": "1.0.0",
  "identifier": "com.adamelmi.moonwave",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run watch",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Moonwave",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "externalBin": ["binaries/yt-dlp", "binaries/ffmpeg", "binaries/ffprobe"],
    "shortDescription": "A music player that lets you download your favorite songs from YouTube",
    "publisher": "Adam Elmi",
    "copyright": "© 2026 Adam Elmi"
  }
}
