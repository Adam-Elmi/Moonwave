# ###################
# Moonwave: the page shell. Each part is a component in src/components;
# the page only lays them out and holds the color tokens
# ###################
[import = Splash: "@/components/Splash.arcm" !]
[import = HeaderBar: "@/components/HeaderBar.arcm" !]
[import = EmptyState: "@/components/EmptyState.arcm" !]
[import = LibraryView: "@/components/LibraryView.arcm" !]
[import = ScanDialog: "@/components/ScanDialog.arcm" !]
[import = ConfirmDialog: "@/components/ConfirmDialog.arcm" !]
[import = PlayerBar: "@/components/PlayerBar.arcm" !]
[import = QueuePanel: "@/components/QueuePanel.arcm" !]
[import = SongMenu: "@/components/SongMenu.arcm" !]
[import = ListDialog: "@/components/ListDialog.arcm" !]
[import = Note: "@/components/Note.arcm" !]
[import = DownloadDialog: "@/components/DownloadDialog.arcm" !]
[import = NowPlaying: "@/components/NowPlaying.arcm" !]
[import = StatusBar: "@/components/StatusBar.arcm" !]
[import = ShortcutsDialog: "@/components/ShortcutsDialog.arcm" !]
[import = AboutCard: "@/components/AboutCard.arcm" !]

[doctype!]
[html = lang: "en"]
  [head]
    [meta = charset: "utf-8" !]
    [meta = name: "viewport", content: "width=device-width, initial-scale=1" !]
    [title]Moonwave[end]
  [end:head]
  [body]
    [Splash !]
    [div = class: "app"]
      [HeaderBar !]
      [main = class: "main"]
        [EmptyState !]
        [LibraryView !]
        [NowPlaying !]
        [QueuePanel !]
      [end:main]
      [PlayerBar !]
      [StatusBar !]
      [SongMenu !]
      [ListDialog !]
      [Note !]
      [DownloadDialog !]
      [ShortcutsDialog !]
      [AboutCard !]
      [ScanDialog !]
      [ConfirmDialog !]
    [end:div]
  [end:body]
[end:html]

[style]
  /* ###################
     A Zed-like look
     ################### */
  @import "@fontsource/ibm-plex-sans/latin-400.css";
  @import "@fontsource/ibm-plex-sans/latin-500.css";
  @import "@fontsource/ibm-plex-sans/latin-600.css";
  @import "@fontsource/ibm-plex-mono/latin-400.css";

  :root {
    --font: "IBM Plex Sans", system-ui, sans-serif;
    --mono: "IBM Plex Mono", ui-monospace, monospace;
    --text: 13px;
    --small: 12px;
    --row: 30px;
    --radius-sm: 4px;
    --radius: 6px;
    --radius-lg: 8px;

    --bg: #fafafa;              /* the main area (Zed's editor) */
    --surface: #ffffff;         /* raised things: dialogs, menus, boxed lists */
    --panel: #f0f0f1;           /* the sidebar, queue, Up Next */
    --headerbar: #e7e7e9;       /* title bar, tabs bar, status bar */
    --line: #d4d4d8;
    --line-soft: #e4e4e7;
    --ink: #24252a;
    --muted: #6b6c73;
    --faint: #9a9ba3;
    --accent: #c2255c;          /* rose, from the logo */
    --accent-hover: #a61e4d;
    --plum: #7b2cbf;
    --accent-fill: var(--accent);             /* buttons and bars: rose (dark: rose → plum) */
    --accent-fill-hover: var(--accent-hover);
    --page: var(--bg);          /* the page behind the songs and Now Playing */
    --page-top: var(--bg);      /* its color at the top left (the open tab joins it) */
    --bar: var(--headerbar);    /* the title bar and status bar */
    --dock: var(--panel);       /* the player bar */
    --control: rgb(0 0 0 / 0.05);
    --control-hover: rgb(0 0 0 / 0.09);
    --hover: rgb(0 0 0 / 0.04);
    --selected: rgb(194 37 92 / 0.1);
    --shadow: 0 8px 24px rgb(0 0 0 / 0.14);
    --ok: #2f9e44;
    --warn: #e67700;
    --error: #d6336c;
    color-scheme: light;
  }
  /* dark: chosen in the title bar (data-theme="dark"), or the system's when the choice is System */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #14121a;
      --surface: #1c1924;
      --panel: #17151e;
      --headerbar: #0f0d14;
      --line: #2a2433;
      --line-soft: #211c29;
      --ink: #e8e2ee;
      --muted: #a79fb5;
      --faint: #6c6479;
      --accent: #f06595;
      --accent-hover: #ff7aa8;
      --plum: #9d4edd;
      --accent-fill: linear-gradient(135deg, var(--accent), var(--plum));
      --accent-fill-hover: linear-gradient(135deg, var(--accent-hover), var(--plum));
      --page-top: #17141f;
      --page:
        radial-gradient(ellipse 60% 45% at 100% 0%, rgb(240 101 149 / 0.07), transparent 70%),
        radial-gradient(ellipse 55% 50% at 0% 100%, rgb(157 78 221 / 0.07), transparent 70%),
        linear-gradient(160deg, #17141f, #14121a 45%, #100e15);
      --bar:
        radial-gradient(ellipse 22% 180% at 50% 50%, rgb(240 101 149 / 0.08), transparent),
        linear-gradient(90deg, #0f0d14, #1c1924 50%, #0f0d14);
      --dock:
        radial-gradient(ellipse 30% 160% at 50% 100%, rgb(240 101 149 / 0.1), transparent),
        linear-gradient(90deg, #120f18, #1c1924 50%, #120f18);
      --control: rgb(255 255 255 / 0.05);
      --control-hover: rgb(255 255 255 / 0.09);
      --hover: rgb(255 255 255 / 0.035);
      --selected: rgb(240 101 149 / 0.14);
      --shadow: 0 10px 30px rgb(0 0 0 / 0.6);
      --ok: #69db7c;
      --warn: #ffa94d;
      --error: #ff6b8a;
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --bg: #14121a;
    --surface: #1c1924;
    --panel: #17151e;
    --headerbar: #0f0d14;
    --line: #2a2433;
    --line-soft: #211c29;
    --ink: #e8e2ee;
    --muted: #a79fb5;
    --faint: #6c6479;
    --accent: #f06595;
    --accent-hover: #ff7aa8;
    --plum: #9d4edd;
    --accent-fill: linear-gradient(135deg, var(--accent), var(--plum));
    --accent-fill-hover: linear-gradient(135deg, var(--accent-hover), var(--plum));
    --page-top: #17141f;
    --page:
      radial-gradient(ellipse 60% 45% at 100% 0%, rgb(240 101 149 / 0.07), transparent 70%),
      radial-gradient(ellipse 55% 50% at 0% 100%, rgb(157 78 221 / 0.07), transparent 70%),
      linear-gradient(160deg, #17141f, #14121a 45%, #100e15);
    --bar:
      radial-gradient(ellipse 22% 180% at 50% 50%, rgb(240 101 149 / 0.08), transparent),
      linear-gradient(90deg, #0f0d14, #1c1924 50%, #0f0d14);
    --dock:
      radial-gradient(ellipse 30% 160% at 50% 100%, rgb(240 101 149 / 0.1), transparent),
      linear-gradient(90deg, #120f18, #1c1924 50%, #120f18);
    --control: rgb(255 255 255 / 0.05);
    --control-hover: rgb(255 255 255 / 0.09);
    --hover: rgb(255 255 255 / 0.035);
    --selected: rgb(240 101 149 / 0.14);
    --shadow: 0 10px 30px rgb(0 0 0 / 0.6);
    --ok: #69db7c;
    --warn: #ffa94d;
    --error: #ff6b8a;
    color-scheme: dark;
  }
  :root[data-theme="light"] {
    color-scheme: light;
  }
  * {
    box-sizing: border-box;
  }
  html,
  body {
    height: 100%;
    margin: 0;
  }
  body {
    font: 400 var(--text) / 1.4 var(--font);
    color: var(--ink);
    background: var(--bg);
    -webkit-user-select: none;
    user-select: none;
  }
  /* ###################
     The slider (seek and volume; slider.js): a thin track filled in rose up to --at,
     and a thumb that shows on hover, focus and while dragging
     ################### */
  .slider {
    position: relative;
    display: block;
    height: 18px;
    cursor: pointer;
    touch-action: none;
    outline: none;
    --at: 0;
  }
  .slider .track {
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    height: 4px;
    overflow: hidden;
    background: var(--control-hover);
    border-radius: 2px;
    transform: translateY(-50%);
  }
  .slider .fill {
    position: absolute;
    inset: 0;
    background: var(--accent-fill);
    transform: scaleX(var(--at));
    transform-origin: left;
  }
  .slider .thumb {
    position: absolute;
    top: 50%;
    left: calc(var(--at) * 100%);
    width: 12px;
    height: 12px;
    background: var(--ink);
    border-radius: 50%;
    opacity: 0;
    transform: translate(-50%, -50%);
    transition: opacity 0.1s;
  }
  .slider:hover .thumb,
  .slider:focus-visible .thumb,
  .slider[data-dragging] .thumb {
    opacity: 1;
  }
  .slider:focus-visible .track {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .app {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .main {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }
[end]
